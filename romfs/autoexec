# Activate the prompt (pressing it again on an open prompt validates the line, like Return)
bind Ctrl+Shift space activate_prompt

# Quit the program (without saving)
bind Ctrl+Shift q quit

# Show and reset the render time information
bind Ctrl t "cvar inf_draw_time"
bind Ctrl+Shift t "reset_draw_time"
bind Ctrl y "cvar inf_command_time"
bind Ctrl+Shift y "reset_command_time"

# Increase and decrease the font size
bind Ctrl "Keypad +" "set_font_size +"
bind Ctrl "Keypad -" "set_font_size -"

# Copy / cut and paste
bind Ctrl c copy
bind Ctrl x cut
bind Ctrl v paste

# Undo and redo the last text modifications
bind Ctrl z undo
bind Ctrl+Shift z redo

# Open a file (prompts for the path)
bind Ctrl o open

# Cycle through the open buffers
bind Ctrl tab "buffer next"
bind Ctrl+Shift tab "buffer prev"

# Close the current buffer (without saving)
bind Ctrl w "buffer close"

# Save the current buffer (prompts for a name when the buffer has none, and for confirmation before erasing a file)
bind Ctrl+Shift s save

# Move the cursor one line up
bind None Up "move up"
bind Shift Up "move up true"

# Move the cursor one line down
bind None Down "move down"
bind Shift Down "move down true"

# Move the cursor one character left
bind None Left "move left"
bind Shift Left "move left true"

# Move the cursor one character right
bind None Right "move right"
bind Shift Right "move right true"

# Move the end or begining of the current line
bind None Home "move bol"
bind Shift Home "move bol true"
bind None End "move eol"
bind Shift End "move eol true"

# Move to the beginning or end of the file
bind Ctrl Home "move bof"
bind Ctrl+Shift Home "move bof true"
bind Ctrl End "move eof"
bind Ctrl+Shift End "move eof true"

# Move a page up or down
bind None PageUp "move page_up"
bind Shift PageUp "move page_up true"
bind None PageDown "move page_down"
bind Shift PageDown "move page_down true"

# auto complete
bind None tab "auto_complete forward"
bind Shift tab "auto_complete backward"

# Search for a term (prompts for the term)
bind Ctrl f search

# search: jump to the next / previous match of the current search term
bind None F3 find_next
bind Shift F3 find_prev

# Go to a line (prompts for the line number)
bind Ctrl g goto_line

# Open the manual
bind None F1 help

# Manual theme override shortcuts (at startup the theme follows the system color scheme when the platform exposes one)
bind Ctrl+Shift l "exec romfs/light_theme"
bind Ctrl+Shift d "exec romfs/dark_theme"

# Game controller — the shoulders are modifier layers: no modifier acts, L selects, R jumps, L+R jumps selecting

# D-pad and left stick move the cursor; L extends the selection
bind None pad:dpup "move up"
bind L pad:dpup "move up true"
bind None pad:dpdown "move down"
bind L pad:dpdown "move down true"
bind None pad:dpleft "move left"
bind L pad:dpleft "move left true"
bind None pad:dpright "move right"
bind L pad:dpright "move right true"
bind None pad:lefty- "move up"
bind L pad:lefty- "move up true"
bind None pad:lefty+ "move down"
bind L pad:lefty+ "move down true"
bind None pad:leftx- "move left"
bind L pad:leftx- "move left true"
bind None pad:leftx+ "move right"
bind L pad:leftx+ "move right true"

# R + d-pad or left stick jumps to the line and file boundaries; L+R jumps extending the selection
bind R pad:dpup "move bof"
bind L+R pad:dpup "move bof true"
bind R pad:dpdown "move eof"
bind L+R pad:dpdown "move eof true"
bind R pad:dpleft "move bol"
bind L+R pad:dpleft "move bol true"
bind R pad:dpright "move eol"
bind L+R pad:dpright "move eol true"
bind R pad:lefty- "move bof"
bind L+R pad:lefty- "move bof true"
bind R pad:lefty+ "move eof"
bind L+R pad:lefty+ "move eof true"
bind R pad:leftx- "move bol"
bind L+R pad:leftx- "move bol true"
bind R pad:leftx+ "move eol"
bind L+R pad:leftx+ "move eol true"

# Triggers (ZL/ZR) and the right stick page up and down
bind None pad:lefttrigger "move page_up"
bind L pad:lefttrigger "move page_up true"
bind None pad:righttrigger "move page_down"
bind L pad:righttrigger "move page_down true"
bind None pad:righty- "move page_up"
bind L pad:righty- "move page_up true"
bind None pad:righty+ "move page_down"
bind L pad:righty+ "move page_down true"

# A confirms and B cancels the prompt (no-ops while it is idle), X opens it and confirms it once open, Y cycles the completions
bind None pad:a "prompt confirm"
bind None pad:b "prompt cancel"
bind None pad:x activate_prompt
bind None pad:y "auto_complete forward"
bind L pad:y "auto_complete backward"

# Face buttons with a shoulder held: clipboard, undo/redo, save, cut and search
bind L pad:a copy
bind R pad:a paste
bind L pad:b undo
bind R pad:b redo
bind L pad:x save
bind R pad:x cut
bind R pad:y search
bind None pad:rightx+ find_next
bind None pad:rightx- find_prev

# Back cycles the open buffers, Start quits
bind None pad:back "buffer next"
bind L pad:back "buffer prev"
bind None pad:start quit

# Left stick click toggles the on-screen keyboard (d-pad/A/B then drive it, B leaves)
bind None pad:leftstick "osk toggle"
